# Copy this file to .env in this same folder and fill in your key.
# .env is already covered by the repo's root .gitignore ("*.env" patterns) --
# never commit your real key.

# Pinecone API key -- from https://app.pinecone.io (free tier is fine)
PINECONE_API_KEY=

# Optional overrides -- defaults shown
# PINECONE_INDEX_NAME=fl-knowledge
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# EMBEDDING_MODEL=all-MiniLM-L6-v2

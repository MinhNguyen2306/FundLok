# FundLok local development environment
# Copy this file to .env before starting the API.

# Local Docker PostgreSQL from docker-compose.yml.
# HANDOFF-02 Fix A: the app is now async (asyncpg). Alembic intentionally
# keeps its own sync (psycopg2) URL -- when running `alembic upgrade head` /
# `alembic check` by hand, override on the command line, e.g.:
#   DATABASE_URL=postgresql+psycopg2://fundlok:fundlok@localhost:5433/fundlok_dev alembic upgrade head
DATABASE_URL=postgresql+asyncpg://fundlok:fundlok@localhost:5433/fundlok_dev

# Development only. Leave FALSE (or unset) in any deployed environment: it
# serves /docs, /redoc and /openapi.json, which publish every route and schema
# in the API.
DEBUG=False

# Auth cookies carry the Secure attribute unless this is False. The code
# defaults to True, so a deployment that omits it is the safe one; local
# development over plain http needs the opt-out (Safari refuses Secure cookies
# on http://localhost, where Chrome and Firefox accept them).
COOKIE_SECURE=False

# Generate a value with: openssl rand -hex 32
SECRET_KEY=replace-with-a-secure-random-string

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
MOCK_UPLOAD_BASE_URL=https://mock-storage.fundlok.local/upload


# # SMTP Configurations (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=False
EMAILS_FROM_EMAIL=noreply@fundlok.com
EMAILS_FROM_NAME=FundLok
# Inbox that /contact submissions are forwarded to (Reply-To = the submitter)
CONTACT_INBOX_EMAIL=support@fundlok.com



# Tells the google-cloud-storage library to look at Docker, not the real GCP
STORAGE_EMULATOR_HOST="http://localhost:4443"

# Your other configurations
GOOGLE_APPLICATION_CREDENTIALS="gcp-credentials.json"
GCP_STORAGE_BUCKET_NAME="fundlok-dev-bucket"
CLOUDFLARE_TURNSTILE_SECRET_KEY="your-secret-key"
# Cloudflare R2 (S3-compatible object storage for loan application documents).
# For local dev, point at the minio container from docker-compose.yml:
R2_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=fundlok-uploads
R2_REGION=auto
R2_PRESIGN_EXPIRE_SECONDS=900

# Didit KYC / identity verification (https://docs.didit.me)
# SECRETS GO IN .env (gitignored), NOT here — this file is committed.
# DIDIT_API_KEY: long-lived key for every verification.didit.me/v3/* call (x-api-key).
# DIDIT_WEBHOOK_SECRET: destination secret_shared_key for X-Signature-V2 HMAC.
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
# workflow_id is per-session config, not a secret. "Free KYC" workflow (investors):
DIDIT_WORKFLOW_ID=a25721c6-f900-4db3-aaff-9ea75b8a5726
# KYB (business verification) workflow for SMEs — create it in the Didit dashboard:
DIDIT_KYB_WORKFLOW_ID=
DIDIT_BASE_URL=https://verification.didit.me
# Where Didit redirects the user after they finish (defaults to FRONTEND_URL/kyc/callback)
DIDIT_CALLBACK_URL=
# Hosted-flow UI language (ISO 639-1). "vi" = Vietnamese, "en" = English.
DIDIT_LANGUAGE=vi

# GVerify / GHub eKYC (Datatrust, API v2.5.1) — direct-API KYC provider, parallel
# to Didit. See docs/specs/gverify/ekyc-kyc-verification.md.
# GVERIFY_BASE_URL: partner-provided {api-base-url}; GVERIFY_API_KEY: x-api-key value;
# GVERIFY_PARTNER_CODE: partner/subpartner "code" sent with every request.
GVERIFY_BASE_URL=
GVERIFY_API_KEY=
GVERIFY_PARTNER_CODE=
# OCR confidence threshold (0-1). Face match has no threshold of ours — the
# verdict follows the provider's is_matching flag directly.
GVERIFY_MIN_OCR_CONFIDENCE=0.85
# KYB (business verification) — docs/specs/gverify/ekyb-kyb-verification.md
GVERIFY_MIN_KYB_OCR_CONFIDENCE=0.85
# Require the SME's KYC-verified CCCD to appear among the certificate's legal
# representatives (spec Rule 7; default off pending review).
GVERIFY_KYB_REQUIRE_REP_MATCH=false




# Encrypts TOTP (two-factor) secrets at rest. Separate from SECRET_KEY on
# purpose: sharing them would mean rotating the JWT key locks every 2FA user out
# of their authenticator app. Leave unset and 2FA enrolment is refused rather
# than storing secrets in plaintext.
#   generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

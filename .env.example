# =================================================================
# FundLok Environment Variables Template
# Copy this file to '.env' and fill in the actual values.
# DO NOT commit the actual '.env' file to version control.
# =================================================================

# --- Database Configuration ---
# Format: postgresql://user:password@localhost:5432/db_name
DATABASE_URL=postgresql://postgres:password@localhost:5432/fundlok_dev

# --- Security ---
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_string_for_development

# --- App Settings ---
DEBUG=True
APP_NAME=FundLok-MVP

# FundLok local development environment
# Copy this file to .env before starting the API.

# Local Docker PostgreSQL from docker-compose.yml
DATABASE_URL=postgresql+psycopg2://fundlok:fundlok@localhost:5433/fundlok_dev

# Generate a value with: openssl rand -hex 32
SECRET_KEY=replace-with-a-secure-random-string

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
MOCK_UPLOAD_BASE_URL=https://mock-storage.fundlok.local/upload


# # SMTP Configurations (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=False
EMAILS_FROM_EMAIL=noreply@fundlok.com
EMAILS_FROM_NAME=FundLok



# Tells the google-cloud-storage library to look at Docker, not the real GCP
STORAGE_EMULATOR_HOST="http://localhost:4443"

# Your other configurations
GOOGLE_APPLICATION_CREDENTIALS="gcp-credentials.json"
GCP_STORAGE_BUCKET_NAME="fundlok-dev-bucket"
CLOUDFLARE_TURNSTILE_SECRET_KEY="your-secret-key"
# Cloudflare R2 (S3-compatible object storage for loan application documents).
# For local dev, point at the minio container from docker-compose.yml:
R2_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=fundlok-uploads
R2_REGION=auto
R2_PRESIGN_EXPIRE_SECONDS=900

# Didit KYC / identity verification (https://docs.didit.me)
# SECRETS GO IN .env (gitignored), NOT here — this file is committed.
# DIDIT_API_KEY: long-lived key for every verification.didit.me/v3/* call (x-api-key).
# DIDIT_WEBHOOK_SECRET: destination secret_shared_key for X-Signature-V2 HMAC.
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
# workflow_id is per-session config, not a secret. "Free KYC" workflow (investors):
DIDIT_WORKFLOW_ID=a25721c6-f900-4db3-aaff-9ea75b8a5726
# KYB (business verification) workflow for SMEs — create it in the Didit dashboard:
DIDIT_KYB_WORKFLOW_ID=
DIDIT_BASE_URL=https://verification.didit.me
# Where Didit redirects the user after they finish (defaults to FRONTEND_URL/kyc/callback)
DIDIT_CALLBACK_URL=
# Hosted-flow UI language (ISO 639-1). "vi" = Vietnamese, "en" = English.
DIDIT_LANGUAGE=vi


